@startuml
skinparam classAttributeIconSize 0
!theme plain

class GestorPersonajes <<static>>{
    {static} +ConsultarPersonajes(): void
}
class GestorObjetos <<static>>{
    {static} +Setup(): void
}
class Personaje{
    -nombre: string
    -vida: float
    -nivel: int
    +ConsultarCaracteristicas(): void
    +ModificarPersonaje(nombre: string, vida: float, nivel: int): void
}
class Inventario{
    +AgregarObjeto(objeto: Objeto): void
    +RetirarObjeto(objeto: Objeto): void
    +CalcularValorTotal(): void
    +Consultarinventario(): void
}
class Objeto{
    -nombre: string
    -valor: int
}

GestorPersonajes "1" o-- "0..*" Personaje: guarda
GestorObjetos "1" o-- "0..*" Objeto: guarda

Personaje "1" *-- "1" Inventario: tiene

Inventario "1" o-- "0..*" Objeto: tiene

@enduml